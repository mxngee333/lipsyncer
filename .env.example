# LipSyncer AI Studio — Environment Template (Copy to .env)
VITE_CANONICAL_URL=https://lipsyncer.web.app

# Hugging Face ZeroGPU Multi-Account Token Pool (Comma-separated hf_... tokens)
VITE_HF_TOKEN=hf_your_primary_token_here
VITE_HF_TOKEN_POOL=hf_token_1,hf_token_2,hf_token_3

# Optional Video Relay Server (Coolify / Hetzner SOCKS5 Relay)
VITE_RELAY_URL=https://relay.modelissa.com

# AI Directors & Keyframe Image Generators
VITE_GEMINI_API_KEY=your_gemini_api_key_here
VITE_SILICONFLOW_API_KEY=your_siliconflow_api_key_here
VITE_GLM_API_KEY=your_zhipu_glm_api_key_here

# Cloudflare R2 Zero-Egress Video Vault
VITE_R2_ACCOUNT_ID=your_r2_account_id
VITE_R2_BUCKET_NAME=lipsyncer
VITE_R2_ACCESS_KEY_ID=your_r2_access_key
VITE_R2_SECRET_ACCESS_KEY=your_r2_secret_key
VITE_R2_PUBLIC_URL=https://pub-xxx.r2.dev

# Firebase Hosting & Analytics
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:xxxxxxxxxxxx
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX
